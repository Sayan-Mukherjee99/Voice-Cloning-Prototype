# ==============================================================================
# VaaniShield Root / Docker Compose Environment Example
# ==============================================================================

# Backend / API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# PostgreSQL / pgvector
POSTGRES_DB=vaanishield
POSTGRES_USER=vaanishield
POSTGRES_PASSWORD=vaanishield_secret
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://vaanishield:vaanishield_secret@postgres:5432/vaanishield

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
