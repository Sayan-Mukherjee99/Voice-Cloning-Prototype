# ==============================================================================
# VaaniShield Backend Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis (Live audio chunk buffer & session state)
REDIS_URL=redis://localhost:6379/0
REDIS_AUDIO_TTL_S=15
BUFFER_WINDOW_FRAMES=24
BUFFER_HOP_FRAMES=12

# PostgreSQL / pgvector (Vector embeddings & audit logs)
POSTGRES_DSN=postgresql://vaanishield:vaanishield_secret@localhost:5432/vaanishield

# ONNX Model Paths (relative to backend or absolute paths)
SILERO_VAD_MODEL=models/silero_vad.onnx
RESNET18_MODEL=models/resnet18_acoustic_quantized.onnx
ECAPA_TDNN_MODEL=models/ecapa_tdnn_192.onnx

# Audio Processing Parameters
SAMPLE_RATE=16000
FRAME_SIZE=1024
N_MELS=80
N_FFT=512
HOP_LENGTH=160
WIN_LENGTH=400

# Scoring & Classification Thresholds (0-100 scale)
TIER2_TRIGGER_THRESHOLD=45.0
RED_THRESHOLD=75.0
AMBER_THRESHOLD=40.0

# EMA Smoothing
EMA_ALPHA_ESCALATE=0.65
EMA_ALPHA_DEESCALATE=0.25
EMA_WINDOW=4

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
